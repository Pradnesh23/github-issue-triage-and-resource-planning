# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
parts/

# Virtual environments
venv/
env/
ENV/
.venv/
.env

# IDEs and editors
.idea/
.vscode/
*.sublime-workspace

# Jupyter
.ipynb_checkpoints

# Data and models (DVC tracked - ignore contents, track .dvc files)
/data/raw/*
/data/processed/*
/best_model_bert_3class/*

# Keep .gitkeep files
!.gitkeep

# But allow DVC pointer files (don't ignore these!)
!*.dvc

# Logs and local environment files
*.log
.env*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Testing and coverage
.pytest_cache/
.mypy_cache/
.cache/
.coverage
htmlcov/

# Credentials (NEVER COMMIT)
credentials/
*.json
!package.json
!metrics.json

# DVC internal cache
.dvc/cache
.dvc/tmp

# MLflow
mlruns/
mlruns.db
/best_model_bert_3class
